// secrets.h.example — copy this to secrets.h and fill it in.
//
// secrets.h is in .gitignore and must stay there. This file, the one with no
// real credentials in it, is the one that gets committed, so anyone reading the
// repo can see what the build needs without ever seeing my network.
//
//   Windows:  copy secrets.h.example secrets.h
//   macOS/Linux:  cp secrets.h.example secrets.h
//
// The Arduino IDE will not show this file as a tab, because it only opens .ino,
// .h, .cpp and .c. Copy it from a file manager or a terminal, then reopen the
// sketch and secrets.h will appear alongside config.h.

#pragma once

// ---------------------------------------------------------------------------
// Wi-Fi
// ---------------------------------------------------------------------------

// 2.4 GHz only. The ESP32-S3 has no 5 GHz radio, and if my AP publishes both
// bands under one SSID this still works — it just associates on 2.4.
#define WIFI_SSID       "my-network"
#define WIFI_PASSWORD   "my-password"

// ---------------------------------------------------------------------------
// MQTT broker
// ---------------------------------------------------------------------------

#define MQTT_HOST       "192.168.1.10"
#define MQTT_PORT       1883

// Leave both as empty strings for an anonymous broker. Mine is not anonymous.
#define MQTT_USER       "plantmonitor"
#define MQTT_PASSWORD   "broker-password"
